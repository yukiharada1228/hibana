server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" always;
    add_header Cache-Control "no-store" always;

    location = /healthz { access_log off; return 200 'ok'; }
    # Nginx error messages include the original URI, including code and state.
    # Keep a sanitized status log instead, including when the CP is unavailable.
    location = /api/auth/oidc/callback {
        error_log /dev/null;
        access_log /dev/stdout hibana_oidc;
        proxy_pass ${HIBANA_API_UPSTREAM}/auth/oidc/callback;
        include /etc/nginx/hibana-api-proxy.conf;
    }
    # Fixed upstream; /api/components becomes /components. Both clients use this path.
    location /api/ {
        proxy_pass ${HIBANA_API_UPSTREAM}/;
        include /etc/nginx/hibana-api-proxy.conf;
    }
    location /assets/ { try_files $uri =404; }
    location / { try_files $uri $uri/ =404; }
}
