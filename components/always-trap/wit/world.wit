package faas:component@1.0.0;

interface types {
    /// ハンドラ実行失敗の分類（§6.5 のエラー分類に対応する最小集合）。
    enum error-kind {
        /// 入力が不正・パース不能。
        invalid-input,
        /// ハンドラ内部の実行時エラー。
        runtime,
        /// 上記に当てはまらない未分類エラー。
        unknown,
    }

    /// ゲスト(Component)が返す構造化エラー。
    record handler-error {
        kind: error-kind,
        message: string,
    }
}

/// 標準ハンドラ world (§4.2)。
/// ゲストは `handle` をエクスポートする。入力・出力は不透明なバイト列で、
/// M1 ではホスト側が serde_json で (de)serialize する規約。
world handler {
    use types.{handler-error};

    export handle: func(input: list<u8>) -> result<list<u8>, handler-error>;
}
