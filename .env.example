# Local development only. Generate private JOB_SIGNING_KEY and SECRETS_MASTER_KEY
# and replace bootstrap credentials before exposing this platform.
DATABASE_URL=postgres://faas_app:faas_app@localhost:5432/faas
MIGRATION_DATABASE_URL=postgres://faas:faas@localhost:5432/faas
RUN_MIGRATIONS=true
BOOTSTRAP_ADMIN_TOKEN=dev-bootstrap-admin-token
OIDC_ISSUER_URL=https://sso.example.com/realms/hibana
OIDC_CLIENT_ID=hibana
OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
OIDC_CALLBACK_URL=http://127.0.0.1:8080/auth/oidc/callback
OIDC_CONSOLE_URL=http://127.0.0.1:5173/
# Development permits HTTP only for literal loopback/localhost URLs.
OIDC_ALLOW_INSECURE_HTTP=true
# Local kind only: allow the IdP's actual discovery/JWKS/token CIDRs and TCP ports.
# Required for the first local platform install; later installs reuse oidc-egress.json.
# HIBANA_OIDC_EGRESS_CIDRS=192.0.2.10/32,2001:db8::10/128
# HIBANA_OIDC_EGRESS_PORTS=443
SMOKE_TENANT_SLUG=smoke
SMOKE_TENANT_NAME=Smoke Tenant
SMOKE_EMAIL=admin@example.com
SMOKE_OIDC_SUBJECT=CHANGE_ME_VERIFIED_OIDC_SUBJECT
BIND_ADDR=0.0.0.0:8080
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hibana-components
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MAX_WASM_UPLOAD_BYTES=33554432
PRESIGN_TTL_SECS=300
WASM_CACHE_DIR=./worker-cache
JOB_SIGNING_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8
JOB_SIGNING_KID=k1
TOKEN_MARGIN_SECS=60
REDIS_URL=redis://localhost:6379
QUOTA_INVOKE_RATE_PER_SEC=50
QUOTA_INVOKE_BURST=500
QUOTA_MAX_CONCURRENT_EXECUTIONS=20
INFLIGHT_TTL_SECS=3600
REAPER_INTERVAL_SECS=30
STUCK_EXECUTION_DEADLINE_SECS=900
TRUST_PROXY_HEADERS=false
SECRETS_MASTER_KEY=CHANGE_ME_REPLACE_WITH_32_BYTE_KEY_BEFORE_USE
SECRETS_MASTER_KID=k1
SECRETS_RETIRED_KEYS=
INTERNAL_BIND_ADDR=127.0.0.1:8081
JOB_ENV_EXCHANGE_RATE_PER_MIN=3500
CONTROL_PLANE_INTERNAL_URL=http://127.0.0.1:8081
JOB_ENV_FETCH_TIMEOUT_MS=2000
WORKER_MAX_CONCURRENCY=8
WORKER_GUEST_MEMORY_BUDGET_MIB=2048
WORKER_MAX_COMPILATIONS=1
WORKER_COMPILER_MEMORY_MIB=1024
WORKER_COMPILER_TIMEOUT_SECS=60
WORKER_DB_MAX_CONNECTIONS=8
WORKER_DRAIN_TIMEOUT_SECS=25
VALIDATION_TIMEOUT_SECS=5
VALIDATION_MEM_LIMIT_MB=256
METRICS_INCLUDE_TENANT_LABEL=true

# Management API, public applications and Worker dispatch have separate listeners.
APP_BIND_ADDR=127.0.0.1:8083
APP_PUBLIC_ORIGIN=http://localhost:8083
WORKER_HTTP_URL=http://127.0.0.1:8084
# Kubernetes uses a separate headless Service that also publishes unready Pods.
# Omit outside Kubernetes to use WORKER_HTTP_URL for preparation as well.
# WORKER_PREPARATION_URL=http://hibana-worker-preparation:8084
WORKER_HTTP_BIND_ADDR=127.0.0.1:8084
