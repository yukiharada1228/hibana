# --- PostgreSQL ---
# sqlx はランタイム API(sqlx::query/query_as)を使うため、ビルド時にDBは不要。
#
# M3b(§3.2): ランタイムは**非特権ロール faas_app**(NOBYPASSRLS・非 SUPERUSER)で接続する。
# postgres イメージの POSTGRES_USER(=faas)は SUPERUSER で、FORCE RLS を無条件にバイパスし、
# GUC 未設定時の fail-closed も働かない。control-plane / worker は起動時に current_user の
# rolsuper/rolbypassrls を検証し、特権なら fail-fast する。
# faas_app のパスワードは 0004_rls.sql の CREATE ROLE と一致させること(下記は開発用既定値)。
DATABASE_URL=postgres://faas_app:faas_app@localhost:5432/faas
#
# マイグレーション専用 URL。0004_rls.sql は CREATE ROLE / FORCE RLS /
# CREATE FUNCTION SECURITY DEFINER を含み、テーブル所有者 + CREATEROLE を要する。
# control-plane は起動時にこの URL(特権ロール)で migrations を適用してから、
# 上の DATABASE_URL(faas_app)でランタイム接続する。未設定なら DATABASE_URL に
# フォールバックする(所有者 1 本で fresh DB を立ち上げる場合)。
MIGRATION_DATABASE_URL=postgres://faas:faas@localhost:5432/faas

# --- NATS (JetStream 有効: `nats-server --jetstream`) ---
NATS_URL=nats://localhost:4222

# --- 認証 (M3a: API トークン方式) ---
# 固定 AUTH_TOKEN は廃止。認証は DB の api_tokens（sha256(secret) 照合）で行う。
# トークンは POST /auth/login（email+password）で発行する。
#
# BOOTSTRAP_ADMIN_TOKEN は system-admin 用。POST /admin/tenants（テナント作成）を
# `Authorization: Bearer ${BOOTSTRAP_ADMIN_TOKEN}` で gate する。必須。
# 露出ガード(§15): 信頼境界外へ展開しないこと。高エントロピーな値に置き換えること。
BOOTSTRAP_ADMIN_TOKEN=dev-bootstrap-admin-token

# make bootstrap / login / deploy / invoke 用のローカルスモーク資格情報。
# migrations が seed する legacy tenant slug "default" とは分離する。
SMOKE_TENANT_SLUG=smoke
SMOKE_TENANT_NAME=Smoke Tenant
SMOKE_EMAIL=admin@example.com
SMOKE_PASSWORD=dev-password

# --- Worker: Component の wasm を読むディレクトリ (M1: COMPONENTS_DIR/{component}.wasm) ---
COMPONENTS_DIR=./components-dist

# --- control-plane の bind アドレス ---
BIND_ADDR=0.0.0.0:8080

# --- Object Storage (M2: MinIO, S3 互換, path-style addressing。§3.4) ---
# 注: この .env は Makefile が `include` するため、値の後ろに行内コメント(`# ...`)を
# 付けないこと（Make が値に末尾空白を残し、数値パースが壊れる）。コメントは行頭に置く。
# MinIO S3 API エンドポイント（docker-compose の minio:9000）
S3_ENDPOINT=http://localhost:9000
# MinIO は任意。aws-sdk が必須とするため固定
S3_REGION=us-east-1
# 本体保存バケット（minio-setup が作成）
S3_BUCKET=faas-components
# MINIO_ROOT_USER と一致
S3_ACCESS_KEY=minioadmin
# MINIO_ROOT_PASSWORD と一致
S3_SECRET_KEY=minioadmin

# --- アップロード/検証パイプライン (M2: §6.2) ---
# wasm 本体の最大サイズ（32 MiB）
MAX_WASM_UPLOAD_BYTES=33554432
# JobMessage に同梱する presigned GET URL の TTL（秒, 短命 read-only）
PRESIGN_TTL_SECS=300

# --- Worker: 取得した wasm 本体のローカルキャッシュ先 (M2: §3.6) ---
WASM_CACHE_DIR=./worker-cache

# --- ジョブ署名トークン (M3c: 結果の出所認証。§3.3) ---
# control-plane だけが Ed25519 署名鍵を持つ。worker は鍵なし（不透明トークンを echo するのみ）。
# JOB_SIGNING_KEY は 32 バイトの Ed25519 seed を hex(64 文字) / base64url / base64 で渡す。
# 露出ガード(§15): 下記は **開発用の決定的ダミー**。本番は高エントロピーな seed に置き換え、
#   信頼境界外へ展開しないこと。
# control-plane の起動時に kid -> 公開鍵マップ（現状 1 エントリ）を構築し、subscriber が
#   結果トークンを kid で検証する。kid を変えると rotation できる（鍵マップに複数登録する拡張余地）。
# 注: この .env は Makefile が include するため、値の後ろに行内コメントを付けないこと。
JOB_SIGNING_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8
JOB_SIGNING_KID=k1

# --- ジョブトークン TTL 結合 (M3c: §3.3) ---
# token exp = iat + ACK_WAIT_SECS*MAX_DELIVER + 実行壁時計上限 + TOKEN_MARGIN_SECS。
# worker の JetStream consumer も同じ ACK_WAIT_SECS / MAX_DELIVER を読む。
# **control-plane と worker で同一の値**にすること（ずれると正規の遅延結果が失効扱いになりうる）。
# 既定は faas_shared の定数（30 / 5 / 60）。通常は未設定で良い（下記はドキュメント用）。
ACK_WAIT_SECS=30
MAX_DELIVER=5
TOKEN_MARGIN_SECS=60

# --- 共有 admission ストア / クォータ (M3d: §8) ---
# 全 Axum インスタンスで共有する低レイテンシカウンタ（Redis）。レート制限・in-flight 同時実行・
# login 失敗ロックアウトを集計する（§8 MUST: インスタンスローカルだと上限が実効 N 倍に緩む）。
# pure-Rust の redis crate（tokio-comp）でアクセスする（当環境は cc/aws-lc 不可）。
# 注: この .env は Makefile が include するため、値の後ろに行内コメントを付けないこと。
REDIS_URL=redis://localhost:6379
#
# テナント別クォータのグローバル既定（§8 表）。tenants.quotas JSONB のテナント上書きが
# 無い場合に適用する。invoke_rate=50 req/s（既定）/ 上限 500、max_concurrent=20 / 上限 200。
# QUOTA_INVOKE_RATE_PER_SEC は token-bucket の補充レート、QUOTA_INVOKE_BURST はバースト容量。
QUOTA_INVOKE_RATE_PER_SEC=50
QUOTA_INVOKE_BURST=500
QUOTA_MAX_CONCURRENT_EXECUTIONS=20
#
# in-flight カウンタキーの TTL（秒）。reaper が DB COUNT（真実）へ再同期するまでの孤立カウンタ保険。
INFLIGHT_TTL_SECS=3600
#
# reaper 再同期間隔（秒, §8 ドリフト補正）。
REAPER_INTERVAL_SECS=30
#
# stuck-execution sweeper の deadline（秒, §8）。created_at + この秒数 を過ぎても終端化されない
# pending/running 行を reaper が failed に finalize して in-flight スロットを回収する（invoke の
# post-commit publish 失敗や worker 取りこぼしによる孤立行を防ぐ）。最悪再配送窓
# （ACK_WAIT_SECS*MAX_DELIVER）+ 実行上限 + 余裕を十分上回る値にすること。0 で無効。
STUCK_EXECUTION_DEADLINE_SECS=900

# --- login 失敗ロックアウト (M3d: §6.0) ---
# (tenant_slug,email) と クライアント IP の **両キー** で失敗を数え、どちらかが閾値到達で
# 401 ロックアウト（fail-closed: 共有ストア到達不能時は拒否, §8）。window 秒間無失敗で解放。
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_WINDOW_SECS=900
#
# X-Forwarded-For を信頼してクライアント IP を取り出すか。既定 false（プロキシ信頼は明示
# オプトイン）。信頼できるリバースプロキシ背後でのみ true にすること（詐称 IP 対策, §6.0）。
TRUST_PROXY_HEADERS=false

# --- 大 I/O アップロード (M3d: §3.4/§5.2/§6.4) ---
# POST /uploads が返す single-key presigned PUT URL の TTL（秒, 短命）。
UPLOAD_PRESIGN_TTL_SECS=300
