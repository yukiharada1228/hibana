# --- PostgreSQL ---
# sqlx はランタイム API(sqlx::query/query_as)を使うため、ビルド時にDBは不要。
#
# M3b(§3.2): ランタイムは**非特権ロール faas_app**(NOBYPASSRLS・非 SUPERUSER)で接続する。
# postgres イメージの POSTGRES_USER(=faas)は SUPERUSER で、FORCE RLS を無条件にバイパスし、
# GUC 未設定時の fail-closed も働かない。control-plane / worker は起動時に current_user の
# rolsuper/rolbypassrls を検証し、特権なら fail-fast する。
# faas_app のパスワードは 0004_rls.sql の CREATE ROLE と一致させること(下記は開発用既定値)。
DATABASE_URL=postgres://faas_app:faas_app@localhost:5432/faas
#
# マイグレーション専用 URL。0004_rls.sql は CREATE ROLE / FORCE RLS /
# CREATE FUNCTION SECURITY DEFINER を含み、テーブル所有者 + CREATEROLE を要する。
# control-plane は起動時にこの URL(特権ロール)で migrations を適用してから、
# 上の DATABASE_URL(faas_app)でランタイム接続する。未設定なら DATABASE_URL に
# フォールバックする(所有者 1 本で fresh DB を立ち上げる場合)。
MIGRATION_DATABASE_URL=postgres://faas:faas@localhost:5432/faas

# --- NATS (JetStream 有効: `nats-server --jetstream`) ---
NATS_URL=nats://localhost:4222

# --- 認証 (M3a: API トークン方式) ---
# 固定 AUTH_TOKEN は廃止。認証は DB の api_tokens（sha256(secret) 照合）で行う。
# トークンは POST /auth/login（email+password）で発行する。
#
# BOOTSTRAP_ADMIN_TOKEN は system-admin 用。POST /admin/tenants（テナント作成）を
# `Authorization: Bearer ${BOOTSTRAP_ADMIN_TOKEN}` で gate する。必須。
# 露出ガード(§15): 信頼境界外へ展開しないこと。高エントロピーな値に置き換えること。
BOOTSTRAP_ADMIN_TOKEN=dev-bootstrap-admin-token

# make bootstrap / login / deploy / invoke 用のローカルスモーク資格情報。
# migrations が seed する legacy tenant slug "default" とは分離する。
SMOKE_TENANT_SLUG=smoke
SMOKE_TENANT_NAME=Smoke Tenant
SMOKE_EMAIL=admin@example.com
SMOKE_PASSWORD=dev-password

# --- Worker: Component の wasm を読むディレクトリ (M1: COMPONENTS_DIR/{component}.wasm) ---
COMPONENTS_DIR=./components-dist

# --- control-plane の bind アドレス ---
BIND_ADDR=0.0.0.0:8080

# --- Object Storage (M2: MinIO, S3 互換, path-style addressing。§3.4) ---
# 注: この .env は Makefile が `include` するため、値の後ろに行内コメント(`# ...`)を
# 付けないこと（Make が値に末尾空白を残し、数値パースが壊れる）。コメントは行頭に置く。
# MinIO S3 API エンドポイント（docker-compose の minio:9000）
S3_ENDPOINT=http://localhost:9000
# MinIO は任意。aws-sdk が必須とするため固定
S3_REGION=us-east-1
# 本体保存バケット（minio-setup が作成）
S3_BUCKET=faas-components
# MINIO_ROOT_USER と一致
S3_ACCESS_KEY=minioadmin
# MINIO_ROOT_PASSWORD と一致
S3_SECRET_KEY=minioadmin

# --- アップロード/検証パイプライン (M2: §6.2) ---
# wasm 本体の最大サイズ（32 MiB）
MAX_WASM_UPLOAD_BYTES=33554432
# JobMessage に同梱する presigned GET URL の TTL（秒, 短命 read-only）
PRESIGN_TTL_SECS=300

# --- Worker: 取得した wasm 本体のローカルキャッシュ先 (M2: §3.6) ---
WASM_CACHE_DIR=./worker-cache

# --- ジョブ署名トークン (M3c: 結果の出所認証。§3.3) ---
# control-plane だけが Ed25519 署名鍵を持つ。worker は鍵なし（不透明トークンを echo するのみ）。
# JOB_SIGNING_KEY は 32 バイトの Ed25519 seed を hex(64 文字) / base64url / base64 で渡す。
# 露出ガード(§15): 下記は **開発用の決定的ダミー**。本番は高エントロピーな seed に置き換え、
#   信頼境界外へ展開しないこと。
# control-plane の起動時に kid -> 公開鍵マップ（現状 1 エントリ）を構築し、subscriber が
#   結果トークンを kid で検証する。kid を変えると rotation できる（鍵マップに複数登録する拡張余地）。
# 注: この .env は Makefile が include するため、値の後ろに行内コメントを付けないこと。
JOB_SIGNING_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8
JOB_SIGNING_KID=k1

# --- ジョブトークン TTL 結合 (M3c: §3.3) ---
# token exp = iat + ACK_WAIT_SECS*MAX_DELIVER + 実行壁時計上限 + TOKEN_MARGIN_SECS。
# worker の JetStream consumer も同じ ACK_WAIT_SECS / MAX_DELIVER を読む。
# **control-plane と worker で同一の値**にすること（ずれると正規の遅延結果が失効扱いになりうる）。
# 既定は faas_shared の定数（30 / 5 / 60）。通常は未設定で良い（下記はドキュメント用）。
ACK_WAIT_SECS=30
MAX_DELIVER=5
TOKEN_MARGIN_SECS=60

# --- 共有 admission ストア / クォータ (M3d: §8) ---
# 全 Axum インスタンスで共有する低レイテンシカウンタ（Redis）。レート制限・in-flight 同時実行・
# login 失敗ロックアウトを集計する（§8 MUST: インスタンスローカルだと上限が実効 N 倍に緩む）。
# pure-Rust の redis crate（tokio-comp）でアクセスする（当環境は cc/aws-lc 不可）。
# 注: この .env は Makefile が include するため、値の後ろに行内コメントを付けないこと。
REDIS_URL=redis://localhost:6379
#
# テナント別クォータのグローバル既定（§8 表）。tenants.quotas JSONB のテナント上書きが
# 無い場合に適用する。invoke_rate=50 req/s（既定）/ 上限 500、max_concurrent=20 / 上限 200。
# QUOTA_INVOKE_RATE_PER_SEC は token-bucket の補充レート、QUOTA_INVOKE_BURST はバースト容量。
QUOTA_INVOKE_RATE_PER_SEC=50
QUOTA_INVOKE_BURST=500
QUOTA_MAX_CONCURRENT_EXECUTIONS=20
#
# in-flight カウンタキーの TTL（秒）。reaper が DB COUNT（真実）へ再同期するまでの孤立カウンタ保険。
INFLIGHT_TTL_SECS=3600
#
# reaper 再同期間隔（秒, §8 ドリフト補正）。
REAPER_INTERVAL_SECS=30
#
# stuck-execution sweeper の deadline（秒, §8）。created_at + この秒数 を過ぎても終端化されない
# pending/running 行を reaper が failed に finalize して in-flight スロットを回収する（invoke の
# post-commit publish 失敗や worker 取りこぼしによる孤立行を防ぐ）。最悪再配送窓
# （ACK_WAIT_SECS*MAX_DELIVER）+ 実行上限 + 余裕を十分上回る値にすること。0 で無効。
STUCK_EXECUTION_DEADLINE_SECS=900

# --- login 失敗ロックアウト (M3d: §6.0) ---
# (tenant_slug,email) と クライアント IP の **両キー** で失敗を数え、どちらかが閾値到達で
# 401 ロックアウト（fail-closed: 共有ストア到達不能時は拒否, §8）。window 秒間無失敗で解放。
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_WINDOW_SECS=900
#
# X-Forwarded-For を信頼してクライアント IP を取り出すか。既定 false（プロキシ信頼は明示
# オプトイン）。信頼できるリバースプロキシ背後でのみ true にすること（詐称 IP 対策, §6.0）。
TRUST_PROXY_HEADERS=false

# --- 大 I/O アップロード (M3d: §3.4/§5.2/§6.4) ---
# POST /uploads が返す single-key presigned PUT URL の TTL（秒, 短命）。
UPLOAD_PRESIGN_TTL_SECS=300

# --- M6: 同期 Invoke / Cron スケジューラ（§15） ---
# この CP インスタンスの subject-safe 識別子。同期 invoke の reply subject
# reply.{INSTANCE_ID}.{correlation_id} に埋め込み、JobMessage を送った当該インスタンスだけが
# reply を購読する（ステートレス×N の鍵）。未設定なら起動時に inst_{uuid} を採番する。
# Axum×N 構成では各インスタンスに一意な値を与えること（重複すると reply 取り違えの恐れ）。
# 注: この .env は Makefile が include するため、値の後ろに行内コメントを付けないこと。
INSTANCE_ID=
# 同期 invoke（?wait=1 / Prefer: wait）の待機上限（ミリ秒）。超過でクライアントへ
# 202 + execution_id にフォールバックする（worker は背後で実行を継続し result/DLQ が finalize）。
SYNC_REPLY_TIMEOUT_MS=5000
# Cron スケジューラの due スキャン間隔（秒）。
CRON_POLL_INTERVAL_SECS=10

# ============================================================================
# --- M7: デプロイ運用とコンフィグ（canary / per-function env / Secrets, §10 / §15） ---
# ============================================================================

# --- M7c Secrets Manager: KEK（鍵暗号化鍵, §4.4 / §10） ---
# secret は封筒暗号（XChaCha20-Poly1305）で保存する。SECRETS_MASTER_KEY は 32 バイトの
# KEK を hex(64 文字) / base64url / base64 で渡す（JOB_SIGNING_KEY と同じ受理規則）。
#
# 露出ガード (MUST): JOB_SIGNING_KEY と違い、**secret の暗号文は DB に永続する**。
#   公開リポジトリに載る既知鍵で暗号化すると影響が長期に残るため、ここには決定的ダミーを
#   置かない。下記プレースホルダのままだと control-plane は **起動に失敗する**（warn ではない）。
#   実鍵の生成例: openssl rand -hex 32
#   さらに Makefile は .env を include + export するため、値は全 make 子プロセスへ渡る。
#   信頼境界外（共有ネットワーク / インターネット到達可能な環境）へ展開しないこと。
#
# 注: この .env は Makefile が include するため、値の後ろに行内コメントを付けないこと。
SECRETS_MASTER_KEY=CHANGE_ME_REPLACE_WITH_32_BYTE_KEY_BEFORE_USE
# 新規暗号化に使う kid。function_secret_versions.kek_kid に記録され復号時の鍵選択に使う。
SECRETS_MASTER_KID=k1
# 復号専用の旧 KEK（kid:key,kid:key の CSV）。KEK ローテーション時に旧鍵をここへ移し、
# POST /admin/secrets/rekey で全行の再ラップが済むまで残す。
# **早期撤去は復号不能 ＝ データ喪失**（署名鍵の overlap 期間と同じ規律）。
SECRETS_RETIRED_KEYS=

# --- M7c: 内部専用 listener（§4.6） ---
# worker が job_env トークンと引き換えに secret を受け取る POST /internal/job-env だけを載せる。
# 公開 listener（BIND_ADDR）には生やさない。**インターネット / 共有ネットワークへ公開しないこと**。
INTERNAL_BIND_ADDR=127.0.0.1:8081
# /internal/job-env の per-IP 上限（req/分）。無認証面のグローバル保護。
JOB_ENV_EXCHANGE_RATE_PER_MIN=600

# --- M7c: worker → control-plane の内部エンドポイント ---
# worker は KEK を持たない（keyless by design, §3.3）。secret は実行のたびにここから引き換える。
CONTROL_PLANE_INTERNAL_URL=http://127.0.0.1:8081
# 引き換え HTTP のタイムアウト（ミリ秒）。超過は fail-closed（実行を failed で終端）。
JOB_ENV_FETCH_TIMEOUT_MS=2000

# ============================================================================
# --- M8: 弾力スケールとテナント間アイソレーション（§8 / §15） ---
# ============================================================================

# --- M8: テナント別 lane Consumer（§3.3 / §8） ---
# 有効にすると、control-plane が **テナントごとに JetStream の lane consumer** を用意し、
# `max_ack_pending` をテナント自身の in-flight 上限から導出する。
#
# 無効（既定）のときは M7 までと同じ「共有 durable `workers` 1 本 + 全テナント合算の
# max_ack_pending=1000」になる。合算方式には次の欠陥がある（M8 が埋める穴の本体）:
#   Σ(アクティブテナント数 × max_concurrent_executions) が 1000 を超えると、
#   **1 件しか投げていないテナントが、他テナントで埋まった配送枠のせいで配送されない**。
#   配送されないと pending 行が減らず、reaper が Redis カウンタを高いまま維持し、
#   やがてそのテナント自身の invoke が 429 になる（＝他人の負荷で自分のクォータが劣化する）。
#   既定 20/テナントなら 50 テナントで破綻する。
#
# ロールバックはこの env を false に戻すだけでよい（reconciler が全 lane を削除して
# legacy consumer へ収束する）。
TENANT_LANES_ENABLED=true
# 専有 lane を割り当てるテナント数の上限。超過分は overflow lane 1 本へ束ねる。
# **完了条件を満たす regime はアクティブテナント数 ≤ この値**。超えた分は overflow lane を
# 共有し、その内部では合算の頭打ちが復活する（有界で明示的な劣化モード）。
MAX_DEDICATED_LANES=64
# lane consumer の max_ack_pending に足す余裕。
# in-flight 上限ちょうどだと、終端と次の配送が重なる瞬間に配送が止まる。
LANE_ACK_PENDING_HEADROOM=8
# overflow lane の max_ack_pending（固定値）。
# **所属テナント数に比例させない**。比例させると合算上限が事実上撤廃され、
# overflow lane が「M7 までの共有 consumer」そのものに戻ってしまう。
LANE_OVERFLOW_ACK_PENDING=1000
# worker 1 プロセスが 1 lane に同時に割ける実行スロットの既定（tenants.quotas で上書き可）。
WORKER_LANE_CONCURRENCY=4
# control-plane の lane reconcile 周期（秒）。単一 writer は pg_try_advisory_lock で強制する。
LANE_RECONCILE_INTERVAL_SECS=10

# --- M8: worker の lane discovery ---
# worker が購読すべき lane を NATS の consumer 一覧から発見する周期（秒）。
# 通常の即応性は control-plane からの `faas.lane.changed` 通知が担い、これは
# 「通知の取りこぼし」と「worker 再起動直後」を吸収する収束用の保険である。
LANE_DISCOVERY_INTERVAL_SECS=10

# --- M8: worker の実行クレジット（§4.2 / §4.3） ---
# **このプロセス全体**の同時実行上限。lane を何本購読していても、実際に走るゲストの数は
# これを超えない。lane ごとのクレジットは `min(consumer metadata の値, この値 ÷ 購読 lane 数)`
# で決まる。**除算で閉じる**のが要点で、第 2 の Semaphore を重ねてはならない
# （lane タスクが自 lane permit を握ったままグローバル permit を待つ hold-and-wait ができ、
#  ack_wait 超過 → 再配送 → 二重実行に化ける）。
WORKER_MAX_CONCURRENCY=32
# lane 数がこの worker の容量を超えたときに、提供する lane 集合を回す周期（秒）。
# この縮退 regime は **完了条件のスコープ外**。未提供 lane のテナントは最大この秒数だけ
# 待たされる（メッセージは WorkQueue に残るので喪失はしない）。
# 検出は `wasmtime_lanes_unserved > 0`。対処は WORKER_MAX_CONCURRENCY を上げるか worker を増やす。
LANE_ROTATION_SECS=30

# --- M8: graceful shutdown（SIGTERM ドレイン, §4.6） ---
# SIGTERM を受けてから in-flight の完了を待つ上限（秒）。
# **0 = シグナルハンドラを一切インストールしない**（M7 までと完全に同一の挙動）。
#
# ドレインが要るのは正しさのためではなく**完了条件のため**である。強制終了しても結果は
# 喪失せず二重課金もしない（終端 CAS が守る）が、**ゲストは 2 回実行され**、そのジョブは
# backoff 待ち + フル再実行を被る。scale-in は定常運用で何度も起きるので、放置すると
# オートスケール機構自身がレイテンシを劣化させる。
#
# 【不変条件】この値は ACK_WAIT_SECS（既定 30）より**厳密に小さい**こと。
# 超えると、まだ実行中のジョブを JetStream が再配送し、ドレインしているのに二重実行になる。
# worker は起動時にこれを検査して fail-fast する。
WORKER_DRAIN_TIMEOUT_SECS=25
