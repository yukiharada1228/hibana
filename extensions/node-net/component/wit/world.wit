package hibana:node-net@0.1.0;

interface transport {
  record failure { code: string, message: string }
  record state { connected: bool, secure: bool, write-closed: bool, alpn: option<string> }
  record tls-options { server-name: string, ca-pem: option<string>, alpn: list<string> }
  resource socket {
    status: func() -> result<state, failure>;
    read: func() -> result<option<list<u8>>, failure>;
    write: func(data: list<u8>) -> result<u32, failure>;
    start-tls: func(options: tls-options) -> result<_, failure>;
    end: func() -> result<_, failure>;
    keep-alive: func(enabled: bool, idle-ms: u32) -> result<_, failure>;
    close: func();
  }
  connect: func(host: string, port: u16) -> result<socket, failure>;
  ip-version: func(address: string) -> u8;
}

world transport-component { export transport; }
