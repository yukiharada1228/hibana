package hibana:postgres@0.1.0;

interface crypto {
  normalize-nfkc: func(value: string) -> result<string, string>;
  random-bytes: func(length: u32) -> result<list<u8>, string>;
  sha256: func(data: list<u8>) -> result<list<u8>, string>;
  md5: func(data: list<u8>) -> result<list<u8>, string>;
  hmac-sha256: func(key: list<u8>, data: list<u8>) -> result<list<u8>, string>;
  derive-key: func(password: list<u8>, salt: list<u8>, iterations: u32) -> result<list<u8>, string>;
}

world postgres-crypto {
  export crypto;
}
